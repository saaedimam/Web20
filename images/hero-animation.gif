
<svg width="400" height="300" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e40af;stop-opacity:0.3" />
      <stop offset="100%" style="stop-color:#059669;stop-opacity:0.3" />
    </linearGradient>
    <pattern id="fabric" patternUnits="userSpaceOnUse" width="20" height="20">
      <rect width="20" height="20" fill="#1e40af" opacity="0.1"/>
      <path d="M0,20 L20,0" stroke="#059669" stroke-width="1" opacity="0.2"/>
      <path d="M0,0 L20,20" stroke="#3b82f6" stroke-width="1" opacity="0.2"/>
    </pattern>
  </defs>
  
  <!-- Background -->
  <rect width="100%" height="100%" fill="url(#grad1)"/>
  
  <!-- Fabric pattern -->
  <rect width="100%" height="100%" fill="url(#fabric)"/>
  
  <!-- Animated textile threads -->
  <g>
    <line x1="0" y1="50" x2="400" y2="50" stroke="#1e40af" stroke-width="2" opacity="0.4">
      <animate attributeName="y1" values="50;100;50" dur="3s" repeatCount="indefinite"/>
      <animate attributeName="y2" values="50;100;50" dur="3s" repeatCount="indefinite"/>
    </line>
    <line x1="0" y1="150" x2="400" y2="150" stroke="#059669" stroke-width="2" opacity="0.4">
      <animate attributeName="y1" values="150;200;150" dur="4s" repeatCount="indefinite"/>
      <animate attributeName="y2" values="150;200;150" dur="4s" repeatCount="indefinite"/>
    </line>
    <line x1="0" y1="250" x2="400" y2="250" stroke="#3b82f6" stroke-width="2" opacity="0.4">
      <animate attributeName="y1" values="250;200;250" dur="5s" repeatCount="indefinite"/>
      <animate attributeName="y2" values="250;200;250" dur="5s" repeatCount="indefinite"/>
    </line>
  </g>
  
  <!-- Floating circles representing textile fibers -->
  <circle cx="50" cy="50" r="3" fill="#1e40af" opacity="0.5">
    <animate attributeName="cy" values="50;250;50" dur="6s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.5;0.8;0.5" dur="6s" repeatCount="indefinite"/>
  </circle>
  <circle cx="150" cy="100" r="2" fill="#059669" opacity="0.5">
    <animate attributeName="cy" values="100;200;100" dur="8s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.5;0.9;0.5" dur="8s" repeatCount="indefinite"/>
  </circle>
  <circle cx="250" cy="75" r="2.5" fill="#3b82f6" opacity="0.5">
    <animate attributeName="cy" values="75;225;75" dur="7s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.5;0.7;0.5" dur="7s" repeatCount="indefinite"/>
  </circle>
  <circle cx="350" cy="125" r="2" fill="#1e40af" opacity="0.5">
    <animate attributeName="cy" values="125;175;125" dur="5s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values="0.5;0.8;0.5" dur="5s" repeatCount="indefinite"/>
  </circle>
</svg>
